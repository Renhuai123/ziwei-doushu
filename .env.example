# 复制为 .env.local 后填入实际值

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# 本仓库已内置 /api/interpret 的实现（见 docs/ai-interpret-api.md）。
# 只想排盘、看命盘的话不用填；要用 AI 解读再填真实 Key 并重启 npm run dev。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
# 可选：换模型 / 换服务端点
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 通用 OpenAI 兼容服务（OpenAI / Moonshot / Qwen / OpenRouter / Ollama）───
# AI_PROVIDER=openai-compatible
# AI_API_KEY=your-api-key
# AI_BASE_URL=https://your-provider/v1
# AI_MODEL=model-name
# 本地 Ollama 示例：AI_BASE_URL=http://127.0.0.1:11434/v1，AI_MODEL=qwen2.5:7b，API Key 可留空

# 可选调参
# AI_TEMPERATURE=0.7
# AI_MAX_TOKENS=2400

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
