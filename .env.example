[TEMPLATE]
# 复制为 .env.local 后填入实际值
# 只排盘、看命盘、看合盘起盘都不需要任何 API Key；
# 下面这些只给 AI 解读接口 /api/interpret 用（合盘 /api/heming 仍需自己实现）。

# ─── AI 解读：Gemini（默认，流式 SSE）───
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# ─── 或改用 OpenAI 兼容协议（DeepSeek / MiMo 等）───
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
#
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
