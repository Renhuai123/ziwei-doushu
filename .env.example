# 复制为 .env.local 后填入实际值

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# 注意：开源版不含 /api/interpret 等后端接口，下面这组配置只在你自己实现了接口后才会用到；
# 只想排盘、看命盘的话不用填。
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── /api/interpret (luận giải AI): AI_PROVIDER=claude-code | codex | zai | anthropic ───
# claude-code / codex chạy CLI đã đăng nhập trên máy (subscription) — chỉ dùng cá nhân, local.
AI_PROVIDER=claude-code
AI_FALLBACK=codex
# CLAUDE_CODE_BIN=claude
# CLAUDE_CODE_MODEL=
# CODEX_BIN=codex
# CODEX_MODEL=
# Z.ai GLM (endpoint tương thích Anthropic) — key tại https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=
ZAI_MODEL=glm-5.3
# ZAI_BASE_URL=https://api.z.ai/api/anthropic
# Claude — key tại https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Dataset luận giải v4.0 (data/dataset-v4/year-YYYY.jsonl.zst). Năm chưa có file thì bỏ qua;
# đặt =1 để server tự tải file năm đó từ GitHub Release khi có người hỏi (~2 MB/năm, kiểm SHA256).
DATASET_V4_AUTO_DOWNLOAD=1

# ── Tracing AI (lib/ai/trace.ts) ──
# Luôn ghi data/traces/YYYY-MM-DD.jsonl (tắt: TRACE_FILE=0). Header phản hồi x-trace-id để tra lại.
# Langfuse: bash scripts/langfuse-setup.sh sẽ tự thêm 3 dòng dưới cho bản tự host (http://localhost:3100).
# LANGFUSE_BASE_URL=http://localhost:3100
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# Gửi nội dung prompt/câu trả lời sang Langfuse: mặc định có khi BASE_URL là localhost, không khi là cloud.
# LANGFUSE_CAPTURE_CONTENT=0
