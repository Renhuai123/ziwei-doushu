# 复制为 .env.local 后填入实际值。只想排盘、看命盘的话什么都不用填。

# ─── AI 解读（/api/interpret、/api/heming）───
# AI_PROVIDER 三选一：deepseek（默认）/ anthropic / openai
AI_PROVIDER=deepseek

# ── DeepSeek ──
DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Claude（AI_PROVIDER=anthropic）──
# 也可以不填 Key，改用 `ant auth login` 的登录态
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-opus-5-5
# 思考深度：low / medium / high / xhigh / max，越高越慢越贵
# ANTHROPIC_EFFORT=medium

# ── 任意 OpenAI 兼容服务（AI_PROVIDER=openai）：通义、Kimi、智谱、OpenAI、本地 vLLM/Ollama 等 ──
# OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=https://your-provider/v1
# OPENAI_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
